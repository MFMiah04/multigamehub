{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (data.child('players').child(auth.uid).exists() || (!data.exists() && newData.child('hostId').val() === auth.uid && newData.child('players').child(auth.uid).exists()) || (!newData.exists() && data.child('token').exists() && root.child('roomIndex').child(data.child('token').val()).val() < now - 1800000))",
        ".validate": "$code.matches(/^[A-Z]{4}$/)",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($code).child('hostId').exists() && !root.child('rooms').child($code).child('kicked').child($uid).exists()",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 16"
            }
          }
        },
        "reactions": {
          "$uid": {
            ".validate": "$uid === auth.uid && newData.hasChildren(['e', 'n', 'at']) && newData.child('e').isString() && newData.child('e').val().matches(/^[a-z]{2,8}$/) && newData.child('n').isString() && newData.child('n').val().matches(/^[a-z0-9]{1,10}$/) && newData.child('at').val() === now && (!data.exists() || now - data.child('at').val() >= 700)",
            "e": {
              ".validate": true
            },
            "n": {
              ".validate": true
            },
            "at": {
              ".validate": true
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "canvases": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (root.child('rooms').child($code).child('players').child(auth.uid).exists() || (!newData.exists() && (!root.child('rooms').child($code).exists() || root.child('roomIndex').child(root.child('rooms').child($code).child('token').val() + '').val() < now - 1800000)))",
        "s": {
          "$stroke": {
            "m": {
              ".validate": "newData.hasChildren(['c', 'w', 'u']) && newData.child('c').isString() && newData.child('c').val().length <= 9 && newData.child('w').isNumber() && newData.child('u').val() === auth.uid && (!newData.child('t').exists() || newData.child('t').val().matches(/^[plrReEf]$/))"
            },
            "x": {
              ".validate": "newData.isBoolean() && newData.parent().child('m').child('u').val() === auth.uid"
            },
            "k": {
              "$n": {
                ".validate": "newData.hasChildren(['p']) && newData.child('p').isString() && newData.child('p').val().length <= 4000"
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        },
        "b": {
          "$layer": {
            "s": {
              "$stroke": {
                "m": {
                  ".validate": "newData.hasChildren(['c', 'w', 'u']) && newData.child('c').isString() && newData.child('c').val().length <= 9 && newData.child('w').isNumber() && newData.child('u').val() === auth.uid && (!newData.child('t').exists() || newData.child('t').val().matches(/^[plrReEf]$/))"
                },
                "x": {
                  ".validate": "newData.isBoolean() && newData.parent().child('m').child('u').val() === auth.uid"
                },
                "k": {
                  "$n": {
                    ".validate": "newData.hasChildren(['p']) && newData.child('p').isString() && newData.child('p').val().length <= 4000"
                  }
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "$other": {
              ".validate": false
            }
          }
        }
      }
    },
    "roomIndex": {
      ".read": "auth != null",
      ".indexOn": ".value",
      "$token": {
        ".write": "auth != null && ((root.child('roomTokens').child($token).exists() && root.child('rooms').child(root.child('roomTokens').child($token).val()).child('players').child(auth.uid).exists()) || (newData.exists() && newData.parent().parent().child('roomTokens').child($token).exists() && newData.parent().parent().child('rooms').child(newData.parent().parent().child('roomTokens').child($token).val()).child('players').child(auth.uid).exists()) || (!newData.exists() && data.val() < now - 1800000))",
        ".validate": "newData.isNumber()"
      }
    },
    "roomTokens": {
      "$token": {
        ".read": "auth != null && root.child('roomIndex').child($token).val() < now - 1800000",
        ".write": "auth != null && ((data.exists() && root.child('rooms').child(data.val()).child('players').child(auth.uid).exists()) || (!data.exists() && newData.exists() && newData.parent().parent().child('rooms').child(newData.val()).child('hostId').val() === auth.uid) || (!newData.exists() && root.child('roomIndex').child($token).val() < now - 1800000))",
        ".validate": "newData.isString() && newData.val().matches(/^[A-Z]{4}$/)"
      }
    },
    "clock": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "!newData.exists() || newData.val() === now"
      }
    }
  }
}